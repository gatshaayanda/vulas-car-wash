rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['owner', 'staff'];
    }
    function validText(value, maxLength) { return value is string && value.size() <= maxLength; }
    function validCustomerRecord(uid) {
      return request.resource.data.keys().hasOnly(['uid','name','email','phone','vehicleRegistrations','createdAt','updatedAt'])
        && request.resource.data.uid == uid
        && validText(request.resource.data.name, 120)
        && validText(request.resource.data.email, 254)
        && validText(request.resource.data.phone, 40)
        && request.resource.data.vehicleRegistrations is list
        && request.resource.data.vehicleRegistrations.size() <= 20
        && validText(request.resource.data.createdAt, 40)
        && validText(request.resource.data.updatedAt, 40);
    }
    function validBooking(uid) {
      return request.resource.data.keys().hasOnly(['customerId','customerName','phone','vehicleType','vehicleRegistration','serviceId','serviceName','serviceIds','serviceNames','basketItems','durationMinutes','serviceMode','locationId','address','scheduledFor','notes','priceQuote','paymentMethod','paymentStatus','status','createdAt','updatedAt'])
        && request.resource.data.keys().hasAll(['customerId','customerName','phone','vehicleType','vehicleRegistration','serviceId','serviceName','serviceMode','locationId','address','scheduledFor','notes','paymentMethod','paymentStatus','status','createdAt','updatedAt'])
        && request.resource.data.customerId == uid
        && validText(request.resource.data.customerName, 120)
        && validText(request.resource.data.phone, 40)
        && validText(request.resource.data.vehicleType, 80)
        && validText(request.resource.data.vehicleRegistration, 30)
        && validText(request.resource.data.serviceId, 120)
        && validText(request.resource.data.serviceName, 120)
        && (!request.resource.data.keys().hasAny(['serviceIds']) || (request.resource.data.serviceIds is list && request.resource.data.serviceIds.size() <= 20))
        && (!request.resource.data.keys().hasAny(['serviceNames']) || (request.resource.data.serviceNames is list && request.resource.data.serviceNames.size() <= 20))
        && (!request.resource.data.keys().hasAny(['basketItems']) || (request.resource.data.basketItems is list && request.resource.data.basketItems.size() <= 20))
        && (!request.resource.data.keys().hasAny(['durationMinutes']) || (request.resource.data.durationMinutes is number && request.resource.data.durationMinutes >= 15 && request.resource.data.durationMinutes <= 240))
        && request.resource.data.serviceMode in ['site','mobile']
        && validText(request.resource.data.locationId, 120)
        && validText(request.resource.data.address, 500)
        && validText(request.resource.data.scheduledFor, 40)
        && validText(request.resource.data.notes, 1500)
        && validText(request.resource.data.paymentMethod, 60)
        && request.resource.data.paymentStatus == 'unpaid'
        && request.resource.data.status == 'requested'
        && validText(request.resource.data.createdAt, 40)
        && validText(request.resource.data.updatedAt, 40)
        && (!request.resource.data.keys().hasAny(['priceQuote']) || (request.resource.data.priceQuote is number && request.resource.data.priceQuote >= 0));
    }
    function validQueueEntry(uid) {
      return request.resource.data.keys().hasOnly(['customerId','customerName','phone','vehicleType','vehicleRegistration','serviceId','serviceName','locationId','notes','status','createdAt','updatedAt'])
        && request.resource.data.keys().hasAll(['customerId','customerName','phone','vehicleType','vehicleRegistration','serviceId','serviceName','locationId','notes','status','createdAt','updatedAt'])
        && request.resource.data.customerId == uid
        && validText(request.resource.data.customerName, 120)
        && validText(request.resource.data.phone, 40)
        && validText(request.resource.data.vehicleType, 80)
        && validText(request.resource.data.vehicleRegistration, 30)
        && validText(request.resource.data.serviceId, 120)
        && validText(request.resource.data.serviceName, 120)
        && validText(request.resource.data.locationId, 120)
        && validText(request.resource.data.notes, 1500)
        && request.resource.data.status == 'waiting'
        && validText(request.resource.data.createdAt, 40)
        && validText(request.resource.data.updatedAt, 40);
    }
    function validFleetRequest(uid) {
      return request.resource.data.keys().hasOnly(['customerId','customerName','phone','vehicleType','vehicleRegistration','notes','businessName','contactName','email','vehicleCount','vehicleTypes','serviceNeeds','preferredLocation','preferredSchedule','status','createdAt','updatedAt'])
        && request.resource.data.keys().hasAll(['customerId','customerName','phone','vehicleType','vehicleRegistration','notes','businessName','contactName','email','vehicleCount','vehicleTypes','serviceNeeds','preferredLocation','preferredSchedule','status','createdAt','updatedAt'])
        && request.resource.data.customerId == uid
        && validText(request.resource.data.businessName, 160)
        && validText(request.resource.data.contactName, 120)
        && validText(request.resource.data.phone, 40)
        && validText(request.resource.data.email, 254)
        && request.resource.data.vehicleCount is int
        && request.resource.data.vehicleCount > 0
        && request.resource.data.vehicleCount <= 10000
        && request.resource.data.vehicleTypes is list
        && request.resource.data.serviceNeeds is list
        && validText(request.resource.data.preferredLocation, 200)
        && validText(request.resource.data.preferredSchedule, 200)
        && validText(request.resource.data.notes, 1500)
        && request.resource.data.status == 'new'
        && validText(request.resource.data.createdAt, 40)
        && validText(request.resource.data.updatedAt, 40);
    }
    match /admins/{uid} {
      allow read: if owns(uid) || isAdmin();
      allow write: if false;
    }
    match /customers/{uid} {
      allow read: if owns(uid) || isAdmin();
      allow create, update: if owns(uid) && validCustomerRecord(uid);
      allow delete: if false;
    }
    match /services/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /gallery/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /businessSettings/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /bookings/{id} {
      allow create: if signedIn() && validBooking(request.auth.uid);
      allow read: if isAdmin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow update: if isAdmin()
        || (signedIn() && resource.data.customerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
          && request.resource.data.status == 'cancelled'
          && resource.data.status in ['requested','confirmed']);
      allow delete: if false;
    }
    match /queueEntries/{id} {
      allow create: if signedIn() && validQueueEntry(request.auth.uid);
      allow read: if isAdmin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow update, delete: if isAdmin();
    }
    match /fleetRequests/{id} {
      allow create: if signedIn() && validFleetRequest(request.auth.uid);
      allow read: if isAdmin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow update, delete: if isAdmin();
    }
    match /loyaltyAccounts/{uid} {
      allow read: if owns(uid) || isAdmin();
      allow write: if isAdmin();
    }
    match /notificationTokens/{uid}/tokens/{tokenId} {
      allow create, update: if owns(uid)
        && request.resource.data.keys().hasOnly(['token','admin','updatedAt'])
        && request.resource.data.token is string
        && request.resource.data.token.size() > 0
        && request.resource.data.admin == false
        && validText(request.resource.data.updatedAt, 40);
      allow read: if false;
      allow delete: if owns(uid) || isAdmin();
    }
    match /reminderPreferences/{uid} {
      allow read: if owns(uid) || isAdmin();
      allow create, update: if owns(uid)
        && request.resource.data.keys().hasOnly(['enabled','channels','updatedAt'])
        && request.resource.data.enabled is bool
        && request.resource.data.channels is list
        && validText(request.resource.data.updatedAt, 40);
      allow delete: if owns(uid) || isAdmin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}